# Server
PORT=3000

# JWT signing secret — REQUIRED: AuthService injects it with @Value and the
# server refuses to boot when it is unset.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated reverse-proxy addresses whose X-Forwarded-For the auth rate
# limiter may trust. Leave empty when clients connect directly.
TRUSTED_PROXIES=

# PostgreSQL (also used by `bun run db:generate`)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asena_example
DB_USER=postgres
DB_PASSWORD=postgres
