# Server
PORT=3000

# Browser origins allowed to call the API with credentials (comma-separated).
# Feeds the CORS policy AND the session cookie's cross-site check.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Session lifetime in seconds (sliding; hard cap 30 days). Default: 12 hours.
SESSION_TTL=43200

# Upper bound for GET /chat/rooms/:id/messages?limit= (injected with @Value).
CHAT_MAX_PAGE_SIZE=100

# Comma-separated reverse-proxy addresses whose X-Forwarded-For the auth rate
# limiter may trust. Leave empty when clients connect directly.
TRUSTED_PROXIES=

# PostgreSQL (also used by `bun run db:generate`)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asena_example
DB_USER=postgres
DB_PASSWORD=postgres
