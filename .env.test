# Loaded automatically by `bun test` (NODE_ENV=test) and wins over a local .env,
# so the suite never depends on a developer's own settings. Test-only values.
#
# The e2e CSRF test trusts http://localhost:5173; the ChatService unit test
# expects the default page cap.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SESSION_TTL=43200
CHAT_MAX_PAGE_SIZE=100
